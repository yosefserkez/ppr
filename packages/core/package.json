{
  "name": "@ppr/core",
  "version": "0.1.0",
  "description": "Portable, local-first engine for ppr: markdown entries, search, links, and pluggable AI.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yosefserkez/ppr.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/yosefserkez/ppr#readme",
  "bugs": {
    "url": "https://github.com/yosefserkez/ppr/issues"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "pnpm build",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.json && node --test \"test/*.test.js\"",
    "eval": "node eval/run.mjs"
  },
  "dependencies": {
    "yaml": "^2.6.1"
  }
}
