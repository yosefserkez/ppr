{
  "name": "ppr-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.24.0",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" build",
    "dev": "pnpm -r --parallel --filter \"./packages/*\" dev",
    "test": "pnpm -r --filter \"./packages/*\" test",
    "typecheck": "pnpm -r --filter \"./packages/*\" typecheck",
    "clean": "rm -rf packages/*/dist packages/*/*.tsbuildinfo",
    "ppr": "node packages/cli/dist/index.js",
    "install:local": "bash scripts/install.sh",
    "uninstall:local": "bash scripts/install.sh --uninstall"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}
